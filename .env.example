# 복사해서 사용: cp .env.example .env
# .env 는 git 에 커밋하지 않는다. API 키를 코드·로그에 남기지 말 것.

APP_ENV=dev

# 기본값: backend/finguard.db (SQLite). PostgreSQL 사용 시:
# DATABASE_URL=postgresql+psycopg://finguard:finguard@localhost:5432/finguard

# LLM (Phase 2)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
# 안전 정책 거절(refusal) 시 서버측 fallback 사용 (Claude API 전용)
LLM_REFUSAL_FALLBACK=true

# 에이전트
AGENT_MAX_STEPS=8
# 게이트웨이 미적용 원본 답변(mode=debug) 허용. 운영 환경에서는 false
ALLOW_DEBUG_MODE=true
# 요청별 trace(JSON Lines, 개인정보 마스킹 후 저장). 비우면 기본 경로 backend/logs/traces.jsonl
# TRACE_LOG_PATH=

# 계산 엔진 정책
# TRUNCATE(원 단위 절사) | HALF_UP | CEILING
ROUNDING_MODE=TRUNCATE
INTEREST_TAX_RATE=0.154

# 데모 테넌트 API 키 (DB 에는 SHA-256 해시만 저장)
DEMO_TENANT_ID=demo
DEMO_API_KEY=demo-key-change-me
